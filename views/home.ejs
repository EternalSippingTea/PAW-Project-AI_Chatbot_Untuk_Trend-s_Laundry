<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beranda | Trend's Laundry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-slate-50 font-sans min-h-screen flex flex-col antialiased">
    <%- include('partials/navbar', { activePage }) %>

    <main class="flex-grow">
        <!-- Hero Section -->
        <section class="bg-white border-b border-slate-200">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-24">
                <div class="max-w-3xl mx-auto text-center">
                    <div class="inline-flex items-center gap-2 bg-sky-50 text-sky-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-sky-100">
                        <i class="fa-solid fa-droplet"></i>
                        <span>Layanan Laundry Profesional</span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 leading-tight tracking-tight">Pakaian bersih, hari lebih ringan</h1>
                    <p class="text-slate-500 text-lg mb-8 leading-relaxed">Pilih layanan laundry yang sesuai, titipkan cucian Anda di toko, dan pantau status pesanan kapan saja dengan kode invoice.</p>
                    <div class="flex flex-wrap justify-center gap-3">
                        <a href="/pemesanan" class="inline-flex items-center gap-2 bg-sky-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-sky-700 transition-colors shadow-sm">
                            <i class="fa-solid fa-basket-shopping text-sm"></i>
                            Pesan Layanan
                        </a>
                        <a href="#layanan" class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 px-6 py-3 rounded-lg font-medium hover:bg-slate-50 transition-colors">
                            <i class="fa-solid fa-tag text-sm"></i>
                            Lihat Tarif
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Strip -->
        <section class="bg-white border-b border-slate-200">
            <div class="max-w-6xl mx-auto px-4 sm:px-6">
                <div class="grid grid-cols-3 divide-x divide-slate-100">
                    <div class="py-6 text-center">
                        <div class="flex items-center justify-center gap-2 mb-1">
                            <i class="fa-solid fa-clock text-sky-600 text-sm"></i>
                            <span class="text-2xl font-bold text-slate-900">24jam</span>
                        </div>
                        <p class="text-xs text-slate-500">Estimasi cuci kilat</p>
                    </div>
                    <div class="py-6 text-center">
                        <div class="flex items-center justify-center gap-2 mb-1">
                            <i class="fa-solid fa-shield-halved text-sky-600 text-sm"></i>
                            <span class="text-2xl font-bold text-slate-900">Aman</span>
                        </div>
                        <p class="text-xs text-slate-500">Garansi cucian</p>
                    </div>
                    <div class="py-6 text-center">
                        <div class="flex items-center justify-center gap-2 mb-1">
                            <i class="fa-solid fa-comments text-sky-600 text-sm"></i>
                            <span class="text-2xl font-bold text-slate-900">Chatbot</span>
                        </div>
                        <p class="text-xs text-slate-500">Cek status cepat</p>
                    </div>
                </div>
            </div>
        </section>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-12">
            <!-- Services Section -->
            <section id="layanan">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-list text-sky-600"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Daftar Layanan & Tarif</h2>
                        <p class="text-sm text-slate-500">Informasi layanan langsung dari Trend's Laundry</p>
                    </div>
                </div>
                <div id="home-service-list" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class="bg-white rounded-xl border border-slate-200 p-5 animate-pulse">
                        <div class="h-5 bg-slate-100 rounded w-2/3 mb-3"></div>
                        <div class="h-4 bg-slate-100 rounded w-full mb-2"></div>
                        <div class="h-4 bg-slate-100 rounded w-1/2"></div>
                    </div>
                </div>
            </section>

            <!-- How It Works -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-route text-sky-600"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Cara Kerja Laundry</h2>
                        <p class="text-sm text-slate-500">Tiga langkah mudah untuk cucian bersih</p>
                    </div>
                </div>
                <div class="grid md:grid-cols-3 gap-4">
                    <article class="bg-white rounded-xl border border-slate-200 p-6 relative">
                        <div class="w-8 h-8 bg-sky-600 text-white rounded-lg flex items-center justify-center text-sm font-bold mb-4">1</div>
                        <h3 class="font-semibold text-slate-900 mb-2">Pilih layanan</h3>
                        <p class="text-sm text-slate-500 leading-relaxed">Lihat pilihan layanan, tarif, dan estimasi pengerjaan di halaman ini.</p>
                        <div class="absolute top-6 right-6">
                            <i class="fa-solid fa-hand-pointer text-slate-200 text-2xl"></i>
                        </div>
                    </article>
                    <article class="bg-white rounded-xl border border-slate-200 p-6 relative">
                        <div class="w-8 h-8 bg-sky-600 text-white rounded-lg flex items-center justify-center text-sm font-bold mb-4">2</div>
                        <h3 class="font-semibold text-slate-900 mb-2">Kirim pesanan</h3>
                        <p class="text-sm text-slate-500 leading-relaxed">Login atau daftar sebagai member, lalu isi detail pesanan online.</p>
                        <div class="absolute top-6 right-6">
                            <i class="fa-solid fa-paper-plane text-slate-200 text-2xl"></i>
                        </div>
                    </article>
                    <article class="bg-white rounded-xl border border-slate-200 p-6 relative">
                        <div class="w-8 h-8 bg-sky-600 text-white rounded-lg flex items-center justify-center text-sm font-bold mb-4">3</div>
                        <h3 class="font-semibold text-slate-900 mb-2">Pantau cucian</h3>
                        <p class="text-sm text-slate-500 leading-relaxed">Gunakan kode invoice pada chatbot untuk melihat status terbaru.</p>
                        <div class="absolute top-6 right-6">
                            <i class="fa-solid fa-magnifying-glass text-slate-200 text-2xl"></i>
                        </div>
                    </article>
                </div>
            </section>
        </div>
    </main>

    <!-- Chatbot Window -->
    <div id="chatbot-container" class="chatbot-window hidden fixed bottom-20 right-5 w-[360px] bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col transition-all duration-300">
        <div class="bg-sky-600 text-white px-4 py-3.5 flex justify-between items-center cursor-pointer" id="chatbot-header">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-robot text-sm"></i>
                </div>
                <div>
                    <span class="font-semibold text-sm block">Asisten Laundry</span>
                    <span class="text-[10px] text-sky-100">Tanya layanan atau cek invoice</span>
                </div>
            </div>
            <button type="button" class="w-7 h-7 rounded-md hover:bg-white/20 flex items-center justify-center transition-colors" aria-label="Tutup chatbot">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
        <div id="chat-messages" class="flex-grow px-4 py-4 bg-slate-50 overflow-y-auto space-y-3">
            <div class="flex gap-2">
                <div class="w-6 h-6 bg-sky-100 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i class="fa-solid fa-robot text-sky-600 text-[10px]"></i>
                </div>
                <p class="text-sm bg-white border border-slate-200 rounded-xl rounded-tl-sm px-3.5 py-2.5 max-w-[85%] text-slate-700">Halo! Tanyakan layanan, tarif, jam operasional, atau masukkan kode invoice untuk cek status cucian.</p>
            </div>
        </div>
        <form id="chat-form" class="border-t border-slate-200 p-3 bg-white flex gap-2">
            <input type="text" id="chat-message" placeholder="Ketik pertanyaan..." maxlength="1000" required class="flex-grow border border-slate-200 rounded-lg px-3.5 py-2.5 outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-100 text-sm bg-white placeholder-slate-400 transition-colors">
            <button type="submit" id="chat-send" aria-label="Kirim pesan" class="bg-sky-600 text-white w-10 h-10 rounded-lg hover:bg-sky-700 disabled:opacity-40 flex items-center justify-center transition-colors flex-shrink-0">
                <i class="fa-solid fa-arrow-up text-sm"></i>
            </button>
        </form>
    </div>

    <!-- Chatbot FAB -->
    <button type="button" id="chatbot-fab" class="chatbot-toggle fixed bottom-5 right-5 bg-sky-600 text-white w-14 h-14 rounded-full shadow-lg flex items-center justify-center hover:bg-sky-700 transition-colors" aria-label="Buka chatbot">
        <i class="fa-solid fa-message text-lg"></i>
    </button>

    <%- include('partials/footer') %>
    <script src="/js/home.js" defer></script>
</body>
</html>